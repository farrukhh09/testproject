# Скопируйте этот файл в .env (в той же папке checker) и заполните.
# Ключи выдаёт https://my.telegram.org → API development tools. Никому их не передавайте.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Регион для номеров без кода страны (TJ — Таджикистан, +992)
CHECKER_DEFAULT_REGION=TJ
# Порт локального проверщика (адрес http://127.0.0.1:8765)
CHECKER_PORT=8765
# Сколько проверок в час (не больше 60) и пауза между проверками в секундах
CHECKER_MAX_PER_HOUR=20
CHECKER_MIN_GAP_SECONDS=5
# Сколько проверок в сутки (не больше 200)
CHECKER_MAX_PER_DAY=50
